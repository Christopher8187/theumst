# Copy to .env and supply private settings; never commit that file.
SERVER=LOCAL
DB_NAME=theumst
DB_USER=postgres
DB_PASSWORD=
# Optional target-specific passwords used by remote packaging.
DB_PASSWORD_COM=
DB_PASSWORD_CN=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SCHEMA_STARTUP_MODE=disabled
HTTP_PORT=8080
SESSION_DAYS=7
COOKIE_SECURE=false
PUBLIC_WEBPAGE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
LOCAL_STORAGE_DIR=__AUTO__
QDRANT_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge-qwen3-embedding-0-6b
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=cosine
QDRANT_VECTORS_ON_DISK=false
DO_SPACES_BUCKET=ultimatemega-audiospace
DO_SPACES_REGION=sfo2
DO_SPACES_ENDPOINT=https://ultimatemega-audiospace.sfo2.digitaloceanspaces.com
DO_SPACES_ACCESS_KEY_ID=
DO_SPACES_SECRET_ACCESS_KEY=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_SECRET_ACCESS_KEY=
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=theumst
SMTP_STARTTLS=true
SMTP_USE_SSL=false
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_HOURS=24
# Announcements use Resend's HTTP API with persistent idempotency keys.
# An empty API key can reuse SMTP_PASSWORD only for SMTP_HOST=smtp.resend.com.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
NEWS_DELIVERY_ENABLED=false
NEWS_POLL_SECONDS=10
REMOTE_SERVER=COM
SSH_HOST_COM=167.71.20.50
SSH_USER_COM=chris
SSH_KEY_COM=chris-theumst-com.pem
REMOTE_ROOT_COM=/var/www/theumst.com
DOMAIN_COM=theumst.com
REMOTE_URL_COM=https://theumst.com
CERT_COM=theumst-com
CERT_MODE_COM=standalone
NGINX_CONF_COM=nginx.server.com.conf
NGINX_SITE_COM=theumst-com
SUDO_PASSWORD_COM=
SSH_HOST_CN=8.153.84.223
SSH_USER_CN=chris
SSH_KEY_CN=
REMOTE_ROOT_CN=/var/www/theumst.cn
DOMAIN_CN=theumst.cn
REMOTE_URL_CN=https://theumst.cn
CERT_CN=theumst-cn
CERT_MODE_CN=manual
NGINX_CONF_CN=nginx.server.cn.conf
NGINX_SITE_CN=theumst-cn
SUDO_PASSWORD_CN=
